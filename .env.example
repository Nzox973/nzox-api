# Copier ce fichier vers .env pour le développement local.
# Générer la clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacer-par-au-moins-32-caracteres-aleatoires

# SQLite local par défaut. PostgreSQL peut être fourni ici en production.
DATABASE_URL=sqlite:///./nzox_api.db

# Origines autorisées, séparées par des virgules. Aucun joker avec une API authentifiée.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
